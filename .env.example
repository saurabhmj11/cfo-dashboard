# AI Financial Analyst - Environment Configuration
# Copy this file to .env and fill in the values

# =============================================================================
# REQUIRED
# =============================================================================

# Secret key for JWT token signing (generate with: openssl rand -hex 32)
SECRET_KEY=your-secret-key-change-in-production

# Google Gemini API Key (get from: https://aistudio.google.com/apikey)
GEMINI_API_KEY=your-gemini-api-key

# =============================================================================
# DATABASE
# =============================================================================

# SQLite (Development - default)
# DATABASE_URL=sqlite:///./data/db/financial_analyst.db

# PostgreSQL (Production)
# DATABASE_URL=postgresql://user:password@localhost:5432/financial_analyst

# =============================================================================
# AUTHENTICATION
# =============================================================================

# Algorithm for JWT tokens
ALGORITHM=HS256

# Access token expiration (minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=15

# Refresh token expiration (days)
REFRESH_TOKEN_EXPIRE_DAYS=7

# Separate secret for refresh tokens
REFRESH_SECRET_KEY=your-refresh-secret-key

# =============================================================================
# OPTIONAL - PRODUCTION
# =============================================================================

# Redis for caching/rate limiting
# REDIS_URL=redis://localhost:6379/0

# Sentry for error tracking
# SENTRY_DSN=https://your-sentry-dsn

# CORS allowed origins (comma-separated)
# CORS_ORIGINS=https://yourdomain.com,https://app.yourdomain.com

# =============================================================================
# DEVELOPMENT
# =============================================================================

# Debug mode (set to false in production)
DEBUG=true

# API host and port
API_HOST=0.0.0.0
API_PORT=8000
